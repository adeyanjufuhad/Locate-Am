# Explicit offline fixture mode; switch to postgres for imported real places.
DATA_MODE=demo
DATABASE_URL=postgresql://locateam:locateam@localhost:5432/locateam
DEMO_DB=data/private/demo.db
ACCEPT_SCORE=0.86
MIN_NAME_SCORE=0.78
AMBIGUITY_MARGIN=0.12
CANDIDATE_FLOOR=0.55
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REQUESTS_PER_MINUTE=60
CONFIRMATIONS_PER_HOUR=10
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in postgres mode. Protects short-lived confirmation tokens and IP hashes.
SIGNING_SECRET=

# Google Maps JavaScript API key for the frontend map component
VITE_GOOGLE_MAPS_API_KEY=
